# Copy this file to `.env` and fill in your own values.
# Never commit your real `.env` file.

# --- Required: LLM provider --------------------------------------------
# LLM_PROVIDER selects the chat model backend: "groq" (default) or "openai".
LLM_PROVIDER=groq

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Only needed if LLM_PROVIDER=openai, or if EMBEDDING_PROVIDER=openai below.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings for the ChromaDB knowledge base. Groq has no embeddings API, so
# this defaults to a local HuggingFace sentence-transformers model (free, no
# key, runs on CPU). Set to "openai" to use OpenAI embeddings instead.
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Optional: higher-quality web search for the Research Agent ------------
# If unset, the Research Agent falls back to free DuckDuckGo + Wikipedia
# search (no key required). Get a free key at https://tavily.com
TAVILY_API_KEY=

# --- Optional: Gmail integration (Module 4) ---------------------------------
# 1. Create a Google Cloud project -> enable the Gmail API.
# 2. Create OAuth 2.0 credentials (Desktop app) and download as JSON.
# 3. Save the file as `credentials.json` in the project root.
# If this file is missing, the Email Agent automatically falls back to a
# local outbox file (data/outbox.jsonl) instead of sending real email.
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json

# --- Optional: Google Drive integration (Module 14) -------------------------
# Reuses the same Google Cloud project — just also enable the Drive API and
# add the drive scope (see README). If credentials are missing, the Drive
# Agent falls back to saving reports under data/drive_storage/.
GOOGLE_DRIVE_FOLDER_ID=

# --- App config ---------------------------------------------------------
APP_DB_PATH=data/iqmath.db
CHROMA_PERSIST_DIR=data/chroma_db
